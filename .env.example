SECRET_KEY=replace-with-a-secure-random-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_inbox

MFA_ISSUER=Sendro
MFA_CHALLENGE_MINUTES=5
MFA_CHALLENGE_MAX_ATTEMPTS=5

TRUSTED_DEVICE_DAYS=15
TRUSTED_DEVICE_MAX_PER_USER=10
TRUSTED_DEVICE_COOKIE_NAME=sendro_trusted_device
TRUSTED_DEVICE_COOKIE_SECURE=true
TRUSTED_DEVICE_COOKIE_SAMESITE=none


# Webhook verification is opt-in until staging has the correct Meta App Secret.
# WHATSAPP_APP_SECRET is your Meta App Secret, NOT the webhook verify token
# and NOT the WhatsApp access token.
# To enable AFTER configuring the real Meta App Secret on the target backend:
WHATSAPP_WEBHOOK_SIGNATURE_REQUIRED=false
# WHATSAPP_APP_SECRET=configure-in-Render-secrets-not-in-GitHub
